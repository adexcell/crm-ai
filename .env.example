# ==============================================================================
# CRM AI: Единая конфигурация монорепозитория (Local Development)
# ==============================================================================

# --- Application ---
APP_NAME="CRM AI Backend"
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# --- Security & JWT ---
SECRET_KEY=super-secret-development-key-minimum-32-characters-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
SUPERADMIN_SECRET_KEY=superadmin-isolated-secret-key-minimum-32-chars

# --- PostgreSQL 16 (с расширением pgvector) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=crm_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# --- Redis 7 ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis

# --- RabbitMQ 3.13 ---
RABBITMQ_DEFAULT_USER=rabbit
RABBITMQ_DEFAULT_PASS=rabbit
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# --- MinIO (S3) ---
# Требование MinIO: пароль строго не менее 8 символов!
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=miniopassword
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_DEFAULT_BUCKET=crm-storage

# --- Kafka & Kafka UI ---
KAFKA_PORT=9094
KAFKA_UI_PORT=8080
KAFKA_BOOTSTRAP_SERVERS=localhost:9094

# --- CORS ---
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://localhost:6006"]
